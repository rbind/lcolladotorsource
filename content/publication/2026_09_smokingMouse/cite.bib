
@article{gonzalez-padilla_molecular_2026,
	title = {Molecular impact of nicotine and smoking exposure on the developing and adult mouse brain},
	volume = {20},
	issn = {2772-3925},
	url = {https://www.sciencedirect.com/science/article/pii/S2772392526000222},
	doi = {10.1016/j.addicn.2026.100270},
	abstract = {Maternal smoking during pregnancy (MSDP) is associated with cognitive and behavioral effects on offspring. Although neurodevelopmental effects of prenatal nicotine exposure (PNE) have been described, the extent to which the molecular impacts of MSDP are attributable to nicotine remains unclear. In addition, the molecular responses to cigarette smoke in the developing and mature brain have not been contrasted. Distinguishing nicotine-specific effects from broader consequences of tobacco exposure is required to inform therapies for affected newborns and cessation strategies for pregnant women. In this study, pregnant mice received nicotine or were exposed to chronic cigarette smoke, and RNA sequencing was performed on frontal cortices of postnatal day 0 pups and adult dams. A total of 1010 and 4165 differentially expressed genes (DEGs) were identified in the nicotine and smoking-exposed pup brain, respectively (19 nicotine-exposed vs 23 vehicle-exposed; 42 smoking-exposed vs 46 controls). PNE was related to dopaminergic synapses and long-term synaptic depression and MSDP to functions of the SNARE complex and vesicle transport. No DEGs at FDR{\textless}0.05 were found in adult mouse brain for any exposure (11 nicotine-administered vs 7 vehicle-administered; 10 smoking-exposed vs 11 controls), nor in whole blood of adult dams–analyzed as proxy for brain effects (12 smoking-exposed vs 11 controls). Nonetheless, 29\% and 43\% of DEGs in smoking-exposed pup brain replicated in blood and human prenatal brain, respectively. Results demonstrate shared and unique effects of PNE and MSDP on the developing brain, attenuated impacts on adult brain, and convergent gene targets in human brain.},
	urldate = {2026-07-31},
	journal = {Addiction Neuroscience},
	author = {Gonzalez-Padilla, Daianna and Eagles, Nicholas J. and Cano, Marisol and Pertea, Geo and Jaffe, Andrew E. and Maynard, Kristen R. and Hancock, Dana B. and Handa, James T. and Martinowich, Keri and Collado-Torres, Leonardo},
	month = sep,
	year = {2026},
	keywords = {Bulk RNA-seq, Gestational smoking, Neurodevelopment, Prenatal nicotine exposure, Substance use disorders},
	pages = {100270}
}
